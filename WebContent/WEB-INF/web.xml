<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Learning Dashboard</display-name>
    <description>Centralized learning platform for course discovery and management</description>

    <!-- Define Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.LoginServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.RegisterServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.LogoutServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>SearchCourseServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.SearchCourseServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>EnrollCourseServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.EnrollCourseServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>UpdateProgressServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.UpdateProgressServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.ProfileServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>CourseDetailServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.CourseDetailServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.AdminUserServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminCourseServlet</servlet-name>
        <servlet-class>com.learningdashboard.servlets.AdminCourseServlet</servlet-class>
    </servlet>

    <!-- Map Servlets to URLs -->
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SearchCourseServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>EnrollCourseServlet</servlet-name>
        <url-pattern>/enrollCourse</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>UpdateProgressServlet</servlet-name>
        <url-pattern>/updateProgress</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CourseDetailServlet</servlet-name>
        <url-pattern>/courseDetail</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminCourseServlet</servlet-name>
        <url-pattern>/admin/courses</url-pattern>
    </servlet-mapping>

    <!-- Configure Filters -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.learningdashboard.filter.AuthenticationFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Session Configuration -->
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
        <timeout>30</timeout>
    </session-config>

    <!-- Welcome Files -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error500.jsp</location>
    </error-page>

    <error-page>
        <error-code>403</error-code>
        <location>/error403.jsp</location>
    </error-page>

</web-app>
